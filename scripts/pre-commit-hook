#!/bin/sh
# pre-commit-hook — Orchestrator for the pre-commit hook suite
# Runs all checks in pre-commit.d/ sequentially with a 30-second total timeout.
# Per-hook skip: SKIP=hook-name1,hook-name2 git commit
# Global skip:   SKIP_PRECOMMIT=1 git commit
# Full mode:     VERINODE_PRECOMMIT_FULL=1 git commit (adds build + tests)
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# --- global skip ---
if [ "${SKIP_PRECOMMIT:-}" = "1" ]; then
  echo "pre-commit: skipped (SKIP_PRECOMMIT=1)"
  exit 0
fi

# --- 30-second timeout ---
TIMEOUT_SECONDS=30
START_TIME=$(date +%s)

check_timeout() {
  NOW=$(date +%s)
  ELAPSED=$((NOW - START_TIME))
  if [ "$ELAPSED" -ge "$TIMEOUT_SECONDS" ]; then
    echo ""
    echo "pre-commit: TIMEOUT after ${TIMEOUT_SECONDS}s — skipping remaining hooks"
    echo "  Hooks completed before timeout may still have reported failures."
    exit 1
  fi
}

# --- collect staged files once (shared via env for hooks that need it) ---
export STAGED_FILES
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)

if [ -z "$STAGED_FILES" ]; then
  echo "pre-commit: no staged files to check"
  exit 0
fi

# --- run hooks ---
HOOK_DIR="pre-commit.d"
TOTAL=0
PASSED=0
FAILED=0
SKIPPED=0
FAIL_HOOKS=""

for hook in "$HOOK_DIR"/*.sh; do
  [ -f "$hook" ] || continue
  TOTAL=$((TOTAL + 1))
  HOOK_NAME=$(basename "$hook" .sh)

  check_timeout

  # Check if this hook is in the SKIP list
  if echo ",${SKIP:-}," | grep -q ",${HOOK_NAME},"; then
    echo "pre-commit [${HOOK_NAME}]: skipped"
    SKIPPED=$((SKIPPED + 1))
    continue
  fi

  # Run the hook
  echo ""
  if sh "$hook"; then
    PASSED=$((PASSED + 1))
  else
    FAILED=$((FAILED + 1))
    FAIL_HOOKS="${FAIL_HOOKS} ${HOOK_NAME}"
  fi
done

check_timeout

# --- optional full build + test ---
if [ "${VERINODE_PRECOMMIT_FULL:-}" = "1" ]; then
  echo ""
  echo "pre-commit: running full build and test suite..."
  if [ -f "package.json" ]; then
    npm run build 2>&1 || { echo "pre-commit: build failed"; exit 1; }
    npm test 2>&1 || { echo "pre-commit: tests failed"; exit 1; }
  fi
fi

# --- summary ---
echo ""
echo "pre-commit: ${PASSED}/${TOTAL} hooks passed"
if [ "$SKIPPED" -gt 0 ]; then
  echo "pre-commit: ${SKIPPED} hook(s) skipped"
fi
if [ "$FAILED" -gt 0 ]; then
  echo "pre-commit: ${FAILED} hook(s) failed:${FAIL_HOOKS}"
  echo ""
  echo "  Fix the issues above, then restage and commit again."
  echo "  Emergency bypass: SKIP=hook-name git commit"
  exit 1
fi

echo "pre-commit: all checks passed"
exit 0
